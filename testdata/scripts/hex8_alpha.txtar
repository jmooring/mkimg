# Regression: 8-digit hex colors with partial alpha must be written with
# straight (non-premultiplied) alpha. Previously, color channels greater than
# the alpha value were corrupted (e.g., 0000ff7f was written as 0000027f).

# 0000ff7f: blue channel exceeds alpha.
exec mkimg -b 1 1 0000ff7f
img -b stdout png 1 1 0000ff7f
! stderr .

# 0000ff80: blue channel exceeds alpha.
exec mkimg -b 1 1 0000ff80
img -b stdout png 1 1 0000ff80
! stderr .

# ff000080: red channel exceeds alpha.
exec mkimg -b 1 1 ff000080
img -b stdout png 1 1 ff000080
! stderr .

# abcdef01: every color channel exceeds alpha.
exec mkimg -b 1 1 abcdef01
img -b stdout png 1 1 abcdef01
! stderr .

# WebP output also preserves straight alpha.
exec mkimg -f webp -b 1 1 0000ff7f
img -b stdout webp 1 1 0000ff7f
! stderr .
